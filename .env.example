# All settings are optional; defaults live in server/src/ingpro/config.py
# INGPRO_STT_MODEL=mlx-community/whisper-large-v3-turbo   # more accurate (esp. Turkish), ~4x slower
# INGPRO_TTS_VOICE=af_heart                                # e.g. am_michael, bf_emma
# INGPRO_TTS_ENGINE=chatterbox                              # chatterbox = one cloned voice for EN+TR | classic = Kokoro + separate Turkish voice (lighter)
# INGPRO_CHATTERBOX_STEPS=5                                # 10 = best quality, 5 = 2x faster (default), 3 = audible degradation
# INGPRO_VOICE_REF=/path/to/your_6-15s_mono_voice.wav      # change how Alex sounds (cloned; default is generated with Kokoro)
# INGPRO_TTS_SPEED=0.9
# INGPRO_TTS_TR_ENGINE=auto                                # auto (macOS Yelda on a Mac, else Piper) | macos | piper
# INGPRO_FILLERS=true                                      # instant spoken reactions ("Hmm, I see.") while the reply is being prepared; false = off
# INGPRO_PROFILE_PATH=/path/to/profile.md                  # notes about you for the tutor (default data/profile.md); see prompts/profile.example.md
# INGPRO_TUTOR_MODEL=claude-sonnet-5                        # claude-haiku-4-5 = faster and lighter on subscription limits, but explanations are noticeably weaker
# INGPRO_JUDGE_MODEL=claude-sonnet-5                        # scores spoken sentences for speaking points, in the background
# INGPRO_VAULT_DIR=/path/to/obsidian/vault/folder          # empty = Obsidian integration off
